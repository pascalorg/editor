{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.pascal/editor",
  "title": "Pascal 3D Editor",
  "description": "Create, inspect, validate, and save editable 3D building scenes with Pascal's MCP server.",
  "version": "1.0.6",
  "websiteUrl": "https://editor.pascal.app/docs/developers/mcp",
  "repository": {
    "url": "https://github.com/pascalorg/editor",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "icons": [
    {
      "src": "https://editor.pascal.app/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://editor.pascal.app/icons/icon-1024.png",
      "mimeType": "image/png",
      "sizes": [
        "1024x1024"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@pascal-app/mcp",
      "version": "1.0.6",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://editor.pascal.app/api/mcp"
    }
  ]
}
