{
  "mcpServers": {
    "pascal": {
      "type": "stdio",
      "command": "pascal",
      "args": ["mcp", "connect"]
    },
    "pascal-hosted": {
      "type": "http",
      "url": "https://editor.pascal.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${PASCAL_API_KEY}"
      }
    }
  }
}
