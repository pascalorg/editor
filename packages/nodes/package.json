{
  "name": "@pascal-app/nodes",
  "version": "1.1.0",
  "description": "Built-in node bundles for the Pascal 3D editor — one folder per kind, exported as `builtinPlugin`",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./procedural-item": {
      "types": "./dist/procedural-item/index.d.ts",
      "import": "./dist/procedural-item/index.js",
      "default": "./dist/procedural-item/index.js"
    },
    "./agent-tools": {
      "types": "./dist/agent-tools/index.d.ts",
      "import": "./dist/agent-tools/index.js",
      "default": "./dist/agent-tools/index.js"
    },
    "./agent-operations": {
      "types": "./dist/agent-operations/index.d.ts",
      "import": "./dist/agent-operations/index.js",
      "default": "./dist/agent-operations/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=6144 tsc --build && bun ../../scripts/fix-node-esm-imports.ts dist",
    "dev": "tsgo --build --watch",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test",
    "bench:elevator": "bun test ./src/elevator/__bench__/rendering.bench.tsx && bun ./src/elevator/__bench__/runtime.ts"
  },
  "peerDependencies": {
    "@pascal-app/core": "^1.1.0",
    "@pascal-app/editor": "^1.1.0",
    "@pascal-app/viewer": "^1.1.0",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "lucide-react": "^1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": "^0.187",
    "zustand": "^5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@pascal-app/core": "^1.1.0",
    "@pascal-app/editor": "^1.1.0",
    "@pascal-app/mcp": "^1.1.0",
    "@pascal-app/viewer": "^1.1.0",
    "@pascal/typescript-config": "*",
    "@react-three/test-renderer": "^9.1.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187",
    "typescript": "7.0.2"
  },
  "keywords": [
    "pascal",
    "3d",
    "editor",
    "node-registry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascalorg/editor.git",
    "directory": "packages/nodes"
  },
  "license": "MIT",
  "homepage": "https://github.com/pascalorg/editor/tree/main/packages/nodes#readme",
  "bugs": "https://github.com/pascalorg/editor/issues",
  "peerDependenciesMeta": {
    "@pascal-app/editor": {
      "optional": true
    }
  }
}
