{
  "name": "@pascal-app/lingo",
  "version": "0.4.0",
  "description": "Make forms easier, LLM tools safer. Parse what humans type and what models emit — natural-language quantities, units, dates and ranges — into canonical, validated values. Two-way, zero dependencies.",
  "keywords": [
    "parse",
    "natural-language",
    "units",
    "measurement",
    "convert",
    "unit-conversion",
    "input",
    "mask",
    "form",
    "date",
    "duration",
    "i18n",
    "locale",
    "humanize",
    "quantity",
    "typescript",
    "zero-dependencies",
    "llm",
    "ai",
    "agents",
    "structured-output",
    "standard-schema",
    "json-schema",
    "tool-calling",
    "mcp",
    "validation"
  ],
  "license": "MIT",
  "author": "Aymeric <aymeric@pascal.app>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
