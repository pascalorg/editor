{
  "name": "@pascal-app/viewer",
  "version": "1.1.0",
  "description": "3D viewer component for Pascal building editor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./dist/capture/index.js",
      "default": "./dist/capture/index.js"
    },
    "./capture/preview": {
      "types": "./dist/capture/preview.d.ts",
      "import": "./dist/capture/preview.js",
      "default": "./dist/capture/preview.js"
    },
    "./sfx": {
      "types": "./dist/sfx/index.d.ts",
      "import": "./dist/sfx/index.js",
      "default": "./dist/sfx/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./ui/theme.css": {
      "style": "./dist/ui/theme.css",
      "default": "./dist/ui/theme.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && cp src/ui/theme.css dist/ui/theme.css",
    "dev": "mkdir -p dist/ui && cp src/ui/theme.css dist/ui/theme.css && tsgo --build --watch",
    "test": "bun test src",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@pascal-app/core": "^1.1.0",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.187"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^1.69.0",
    "tailwind-merge": "^3.7.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "~0.9.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@pascal-app/core": "^1.1.0",
    "@pascal/typescript-config": "*",
    "@react-three/test-renderer": "^9.1.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187",
    "typescript": "7.0.2"
  },
  "keywords": [
    "3d",
    "building",
    "editor",
    "viewer",
    "architecture",
    "webgpu",
    "three.js",
    "react-three-fiber"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascalorg/editor.git",
    "directory": "packages/viewer"
  },
  "license": "MIT",
  "homepage": "https://github.com/pascalorg/editor/tree/main/packages/viewer#readme",
  "bugs": "https://github.com/pascalorg/editor/issues"
}
