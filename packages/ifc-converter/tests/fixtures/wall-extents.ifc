ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Wall extent fallback fixture: two IFCWALLs without an extrusion body, 5 m long, 0.3 m thick, 3 m high: a faceted Brep turned 53.13 degrees off IFC +X, and the same Brep through an IfcMappedItem turned -36.87 degrees'),'2;1');
FILE_NAME('wall-extents.ifc','2026-09-26T00:00:00',('Pascal'),('Pascal'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Wall extent fixture',$,$,$,$,(#8),#9);
#2=IFCCARTESIANPOINT((0.,0.,0.));
#3=IFCDIRECTION((0.,0.,1.));
#4=IFCDIRECTION((1.,0.,0.));
#6=IFCAXIS2PLACEMENT3D(#2,#3,#4);
#8=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.00001,#6,$);
#9=IFCUNITASSIGNMENT((#10));
#10=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#13=IFCLOCALPLACEMENT($,#6);
#14=IFCSITE('0000000000000000000002',$,'Site',$,$,#13,$,$,.ELEMENT.,$,$,$,$,$);
#15=IFCRELAGGREGATES('0000000000000000000003',$,$,$,#1,(#14));
#22=IFCLOCALPLACEMENT(#13,#6);
#23=IFCBUILDING('0000000000000000000004',$,'Building',$,$,#22,$,$,.ELEMENT.,$,$,$);
#24=IFCRELAGGREGATES('0000000000000000000005',$,$,$,#14,(#23));
#32=IFCLOCALPLACEMENT(#22,#6);
#33=IFCBUILDINGSTOREY('0000000000000000000006',$,'Ground',$,$,#32,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('0000000000000000000007',$,$,$,#23,(#33));
#35=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000008',$,$,$,(#100,#130),#33);
/* The wall's local X is world (0.6, 0.8): it runs north-east from (1, 2). */
#80=IFCCARTESIANPOINT((1.,2.,0.));
#81=IFCDIRECTION((0.6,0.8,0.));
#82=IFCAXIS2PLACEMENT3D(#80,#3,#81);
#83=IFCLOCALPLACEMENT(#32,#82);
#85=IFCCARTESIANPOINT((0.,0.));
#86=IFCCARTESIANPOINT((5.,0.));
#87=IFCPOLYLINE((#85,#86));
#88=IFCSHAPEREPRESENTATION(#8,'Axis','Curve2D',(#87));
#400=IFCCARTESIANPOINT((0.00,-0.15,0.00));
#401=IFCCARTESIANPOINT((5.00,-0.15,0.00));
#402=IFCCARTESIANPOINT((5.00,0.15,0.00));
#403=IFCCARTESIANPOINT((0.00,0.15,0.00));
#404=IFCCARTESIANPOINT((0.00,-0.15,3.00));
#405=IFCCARTESIANPOINT((5.00,-0.15,3.00));
#406=IFCCARTESIANPOINT((5.00,0.15,3.00));
#407=IFCCARTESIANPOINT((0.00,0.15,3.00));
#408=IFCPOLYLOOP((#400,#403,#402,#401));
#409=IFCFACEOUTERBOUND(#408,.T.);
#410=IFCFACE((#409));
#411=IFCPOLYLOOP((#404,#405,#406,#407));
#412=IFCFACEOUTERBOUND(#411,.T.);
#413=IFCFACE((#412));
#414=IFCPOLYLOOP((#400,#401,#405,#404));
#415=IFCFACEOUTERBOUND(#414,.T.);
#416=IFCFACE((#415));
#417=IFCPOLYLOOP((#401,#402,#406,#405));
#418=IFCFACEOUTERBOUND(#417,.T.);
#419=IFCFACE((#418));
#420=IFCPOLYLOOP((#402,#403,#407,#406));
#421=IFCFACEOUTERBOUND(#420,.T.);
#422=IFCFACE((#421));
#423=IFCPOLYLOOP((#403,#400,#404,#407));
#424=IFCFACEOUTERBOUND(#423,.T.);
#425=IFCFACE((#424));
#426=IFCCLOSEDSHELL((#410,#413,#416,#419,#422,#425));
#427=IFCFACETEDBREP(#426);
#90=IFCSHAPEREPRESENTATION(#8,'Body','Brep',(#427));
#91=IFCPRODUCTDEFINITIONSHAPE($,$,(#88,#90));
#100=IFCWALL('0000000000000000000010',$,'Brep wall',$,$,#83,#91,$,.STANDARD.);
/* The same body as a mapped representation (IfcRepresentationMap + IfcMappedItem), local X = world (0.8, -0.6), from (10, 0). */
#110=IFCREPRESENTATIONMAP(#6,#90);
#111=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#2,1.,$);
#112=IFCMAPPEDITEM(#110,#111);
#113=IFCSHAPEREPRESENTATION(#8,'Body','MappedRepresentation',(#112));
#114=IFCPRODUCTDEFINITIONSHAPE($,$,(#88,#113));
#120=IFCCARTESIANPOINT((10.,0.,0.));
#121=IFCDIRECTION((0.8,-0.6,0.));
#122=IFCAXIS2PLACEMENT3D(#120,#3,#121);
#123=IFCLOCALPLACEMENT(#32,#122);
#130=IFCWALL('0000000000000000000011',$,'Mapped wall',$,$,#123,#114,$,.STANDARD.);
ENDSEC;
END-ISO-10303-21;
