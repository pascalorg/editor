ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Plan handedness regression fixture: L-shaped walls, one door, an L-shaped slab and a proxy box north-east of the corner'),'2;1');
FILE_NAME('handedness.ifc','2026-09-25T00:00:00',('Pascal'),('Pascal'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Handedness fixture',$,$,$,$,(#8),#9);
#2=IFCCARTESIANPOINT((0.,0.,0.));
#3=IFCDIRECTION((0.,0.,1.));
#4=IFCDIRECTION((1.,0.,0.));
#5=IFCDIRECTION((0.,1.,0.));
#6=IFCAXIS2PLACEMENT3D(#2,#3,#4);
#7=IFCAXIS2PLACEMENT2D(#85,$);
#8=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.00001,#6,$);
#9=IFCUNITASSIGNMENT((#10));
#10=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#13=IFCLOCALPLACEMENT($,#6);
#14=IFCSITE('0000000000000000000002',$,'Site',$,$,#13,$,$,.ELEMENT.,$,$,$,$,$);
#15=IFCRELAGGREGATES('0000000000000000000003',$,$,$,#1,(#14));
#22=IFCLOCALPLACEMENT(#13,#6);
#23=IFCBUILDING('0000000000000000000004',$,'Building',$,$,#22,$,$,.ELEMENT.,$,$,$);
#24=IFCRELAGGREGATES('0000000000000000000005',$,$,$,#14,(#23));
#32=IFCLOCALPLACEMENT(#22,#6);
#33=IFCBUILDINGSTOREY('0000000000000000000006',$,'Ground',$,$,#32,$,$,.ELEMENT.,0.);
#34=IFCRELAGGREGATES('0000000000000000000007',$,$,$,#23,(#33));
#35=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000008',$,$,$,(#100,#120,#200,#300),#33);
#85=IFCCARTESIANPOINT((0.,0.));
/* Wall A runs 4 m east along IFC +X. */
#90=IFCLOCALPLACEMENT(#32,#6);
#91=IFCCARTESIANPOINT((4.,0.));
#92=IFCPOLYLINE((#85,#91));
#93=IFCSHAPEREPRESENTATION(#8,'Axis','Curve2D',(#92));
#94=IFCCARTESIANPOINT((2.,0.));
#95=IFCAXIS2PLACEMENT2D(#94,$);
#96=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall A',#95,4.,0.2);
#97=IFCEXTRUDEDAREASOLID(#96,#6,#3,2.7);
#98=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#97));
#99=IFCPRODUCTDEFINITIONSHAPE($,$,(#93,#98));
#100=IFCWALLSTANDARDCASE('0000000000000000000010',$,'Wall A east',$,$,#90,#99,$,.STANDARD.);
/* Wall B runs 2 m north along IFC +Y: its local X is turned onto world +Y. */
#110=IFCAXIS2PLACEMENT3D(#2,#3,#5);
#111=IFCLOCALPLACEMENT(#32,#110);
#112=IFCCARTESIANPOINT((2.,0.));
#113=IFCPOLYLINE((#85,#112));
#114=IFCSHAPEREPRESENTATION(#8,'Axis','Curve2D',(#113));
#115=IFCCARTESIANPOINT((1.,0.));
#116=IFCAXIS2PLACEMENT2D(#115,$);
#117=IFCRECTANGLEPROFILEDEF(.AREA.,'Wall B',#116,2.,0.2);
#118=IFCEXTRUDEDAREASOLID(#117,#6,#3,2.7);
#119=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#118));
#121=IFCPRODUCTDEFINITIONSHAPE($,$,(#114,#119));
#120=IFCWALLSTANDARDCASE('0000000000000000000011',$,'Wall B north',$,$,#111,#121,$,.STANDARD.);
/* A door 1 m from wall A's start: asymmetric along the wall. */
#130=IFCCARTESIANPOINT((1.,0.,0.));
#131=IFCAXIS2PLACEMENT3D(#130,#3,#4);
#132=IFCLOCALPLACEMENT(#90,#131);
#133=IFCRECTANGLEPROFILEDEF(.AREA.,'Opening',#7,0.9,0.4);
#134=IFCEXTRUDEDAREASOLID(#133,#6,#3,2.1);
#135=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#134));
#136=IFCPRODUCTDEFINITIONSHAPE($,$,(#135));
#137=IFCOPENINGELEMENT('0000000000000000000012',$,'Door opening',$,$,#132,#136,$,.OPENING.);
#138=IFCRELVOIDSELEMENT('0000000000000000000013',$,$,$,#100,#137);
#139=IFCLOCALPLACEMENT(#132,#6);
#140=IFCDOOR('0000000000000000000014',$,'Door',$,$,#139,$,$,2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#141=IFCRELFILLSELEMENT('0000000000000000000015',$,$,$,#137,#140);
/* An L-shaped floor slab: the notch is at the north-east. */
#150=IFCCARTESIANPOINT((4.,1.));
#151=IFCCARTESIANPOINT((1.,1.));
#152=IFCCARTESIANPOINT((1.,2.));
#153=IFCCARTESIANPOINT((0.,2.));
#154=IFCPOLYLINE((#85,#91,#150,#151,#152,#153,#85));
#155=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'Slab',#154);
#156=IFCEXTRUDEDAREASOLID(#155,#6,#3,0.2);
#157=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#156));
#158=IFCPRODUCTDEFINITIONSHAPE($,$,(#157));
#159=IFCLOCALPLACEMENT(#32,#6);
#200=IFCSLAB('0000000000000000000016',$,'Floor',$,$,#159,#158,$,.FLOOR.);
/* A 0.5 m box centred 3 m east and 1.5 m north of the corner (copied as a mesh). */
#210=IFCCARTESIANPOINT((3.,1.5,0.));
#211=IFCAXIS2PLACEMENT3D(#210,#3,#4);
#212=IFCLOCALPLACEMENT(#32,#211);
#213=IFCRECTANGLEPROFILEDEF(.AREA.,'Box',#7,0.5,0.5);
#214=IFCEXTRUDEDAREASOLID(#213,#6,#3,1.);
#215=IFCSHAPEREPRESENTATION(#8,'Body','SweptSolid',(#214));
#216=IFCPRODUCTDEFINITIONSHAPE($,$,(#215));
#300=IFCBUILDINGELEMENTPROXY('0000000000000000000017',$,'North-east box',$,$,#212,#216,$,.ELEMENT.);
ENDSEC;
END-ISO-10303-21;
