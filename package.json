{
  "name": "editor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e ./.env -e ./.env.defaults -- turbo run dev --env-mode=loose",
    "lint": "biome lint",
    "lints": "bun run lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "checks": "bun run check && bun run check-types",
    "check:fix": "biome check --write",
    "check-types": "turbo run check-types",
    "i18n:check": "bun scripts/i18n.ts check",
    "i18n:compile": "bun scripts/i18n.ts compile",
    "i18n:extract": "bun scripts/i18n.ts extract",
    "i18n:literals": "bun scripts/i18n-literals.ts",
    "i18n:pseudo-audit": "bun scripts/i18n-pseudo-audit.ts",
    "i18n:translate": "bun scripts/i18n.ts translate",
    "test": "turbo run test && bun test scripts/i18n.test.ts scripts/i18n-literals.test.ts apps/editor/proxy.test.ts",
    "ci": "bun run check && bun run i18n:check && bun run skills:validate && bun run check-types && bun run test && bun run build",
    "postinstall": "([ -n \"$CI\" ] || [ ! -e .git ] || git config core.hooksPath .githooks)",
    "skills:validate": "bun scripts/validate-skills.ts && bun scripts/sync-agent-versions.ts --check && bun test scripts/sync-agent-versions.test.ts scripts/cursor-plugin-policy.test.ts scripts/clawhub-ignore-policy.test.ts scripts/claude-mcp-config-policy.test.ts scripts/openai-tool-annotation-policy.test.ts scripts/path-containment.test.ts scripts/public-skill-discovery-policy.test.ts",
    "kill": "lsof -ti:3002 | xargs kill -9 2>/dev/null || echo 'No processes found on port 3002'",
    "clean:cache": "rm -rf apps/*/.next apps/*/.swc apps/*/.turbo packages/*/.turbo tooling/*/.turbo .turbo node_modules/.cache",
    "restart": "bun kill && bun clean:cache && bun dev",
    "release": "gh workflow run release.yml -f bump=patch",
    "release:beta": "gh workflow run release.yml -f bump=beta",
    "release:minor": "gh workflow run release.yml -f bump=minor",
    "release:major": "gh workflow run release.yml -f bump=major"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/openai": "^4.0.103",
    "@biomejs/biome": "^2.6.3",
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/message-utils": "6.10.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@typescript/typescript6": "6.0.2",
    "ai": "^7.0.154",
    "dotenv-cli": "^11.0.0",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "playwright-core": "1.64.1",
    "pofile-ts": "^4.0.3",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "^8.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.13.14",
    "next": "16.4.3",
    "react-grab": "0.2.0",
    "three": "0.186.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@react-three/fiber": "9.8.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "patchedDependencies": {
    "iwer@2.3.0": "patches/iwer@2.3.0.patch",
    "three@0.186.1": "patches/three@0.186.1.patch",
    "three-bvh-csg@0.0.18": "patches/three-bvh-csg@0.0.18.patch"
  }
}
