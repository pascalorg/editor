# Pascal instance to read from. Defaults to https://editor.pascal.app.
VITE_PASCAL_BASE_URL=https://editor.pascal.app

# Project to show when the address has no ?project=<id>. Must be public and published.
VITE_PASCAL_PROJECT_ID=

# Hosts the signed 3D-file URLs point at, added to the Content-Security-Policy
# (space or comma separated). Defaults to https://*.supabase.co.
# VITE_PASCAL_ASSET_ORIGINS=https://*.supabase.co

# Never put a Pascal API key in a VITE_ variable: everything here ships to the browser.
