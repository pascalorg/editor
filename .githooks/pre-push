#!/usr/bin/env bash
# Fast local mirror of the CI quality job for what this branch changes.
# Full parity: `bun run ci`. Skip once with `git push --no-verify`.
set -euo pipefail

base=$(git merge-base HEAD origin/main 2>/dev/null || echo origin/main)
changed=$(git diff --name-only "$base" HEAD)

if echo "$changed" | grep -qE '(^|/)package\.json$|^bun\.lock$'; then
  echo "pre-push: checking bun.lock is in sync"
  if ! bun install --frozen-lockfile --dry-run >/dev/null 2>&1; then
    echo "pre-push: bun.lock is out of date. Run \`bun install\` and commit bun.lock." >&2
    exit 1
  fi
fi

echo "pre-push: lint"
bun run --silent check

# Directly changed packages only: `...[$base]` also pulled in every dependent,
# so a core edit typechecked and tested the whole graph before each push. CI
# owns that parity; this hook is fast feedback.
echo "pre-push: typecheck changed packages"
bunx turbo run check-types --filter="[$base]" --output-logs=errors-only
